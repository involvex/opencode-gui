{
	"name": "involvexs-opencode-gui",
	"displayName": "OpenCode GUI (Involvex)",
	"version": "0.4.4",
	"description": "OpenCode AI coding agent for VSCode GUI extension",
	"categories": [
		"Other",
		"AI"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/opencode-gui.git"
	},
	"author": "involvex",
	"publisher": "involvex",
	"main": "./dist/extension.js",
	"scripts": {
		"prebuild": "bun run format && bun run lint && bun run typecheck",
		"build": "bun run build:extension && bun run build:webview",
		"build:extension": "vite build --config vite.config.extension.ts",
		"build:webview": "vite build --config vite.config.ts",
		"clean": "bunx del-cli dist out",
		"debug:extension": "tsx scripts/debug-extension.ts",
		"dev": "tsx scripts/dev.ts",
		"dev:standalone": "vite --open /src/webview/standalone.html",
		"dev:webview": "vite",
		"format": "prettier . --write",
		"google-login": "gcloud auth application-default login",
		"lint": "eslint .",
		"package": "bunx @vscode/vsce package --no-dependencies",
		"publish": "vsce publish --skip-duplicate --no-dependencies && ovsx publish -p \"$OPEN_VSX_KEY\" --no-dependencies",
		"publish:pre": "vsce publish --pre-release --no-dependencies && source .env && ovsx publish --pre-release -p \"$OPEN_VSX_KEY\" --no-dependencies",
		"test": "vitest run && playwright test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:integration": "tsc -p tsconfig.integration.json && node out/tests/integration/runTests.js",
		"test:integration:compile": "tsc -p tsconfig.integration.json",
		"typecheck": "tsc --noEmit",
		"uikit": "vite --open /src/webview/uikit.html",
		"vscode:prepublish": "bun run build",
		"watch": "concurrently \"bun run watch:extension\" \"bun run watch:webview\"",
		"watch:extension": "vite build --config vite.config.extension.ts --watch --mode development",
		"watch:webview": "vite build --config vite.config.ts --watch --mode development"
	},
	"contributes": {
		"commands": [
			{
				"command": "opencode.addSelectionToPrompt",
				"title": "Add Selection to Prompt",
				"category": "OpenCode"
			},
			{
				"command": "opencode.restartserver",
				"title": "Restart OpenCode Server",
				"category": "OpenCode"
			},
			{
				"command": "opencode.modelConfig",
				"title": "Model Configuration",
				"category": "OpenCode"
			},
			{
				"command": "opencode.config.setModel",
				"title": "Set Model",
				"category": "OpenCode"
			},
			{
				"command": "opencode.config.setApiEndpoint",
				"title": "Set API Endpoint",
				"category": "OpenCode"
			},
			{
				"command": "opencode.config.setTemperature",
				"title": "Set Temperature",
				"category": "OpenCode"
			},
			{
				"command": "opencode.config.setMaxTokens",
				"title": "Set Max Tokens",
				"category": "OpenCode"
			}
		],
		"configuration": {
			"title": "OpenCode",
			"properties": {
				"opencode.serverUrl": {
					"type": "string",
					"default": "",
					"description": "OpenCode server URL (e.g., http://localhost:9090). Leave empty for auto-detect/spawn."
				},
				"opencode.serverPort": {
					"type": "number",
					"default": 0,
					"description": "Port for the OpenCode server. Use 0 for auto-assign (recommended)."
				},
				"opencode.openaiApiKey": {
					"type": "string",
					"default": "",
					"description": "OpenAI API key for authentication."
				},
				"opencode.anthropicApiKey": {
					"type": "string",
					"default": "",
					"description": "Anthropic API key for authentication."
				},
				"opencode.openrouterApiKey": {
					"type": "string",
					"default": "",
					"description": "OpenRouter API key for authentication."
				},
				"opencode.cloudflareApiKey": {
					"type": "string",
					"default": "",
					"description": "Cloudflare API key for Workers AI."
				},
				"opencode.googleApiKey": {
					"type": "string",
					"default": "",
					"description": "Google API key for Vertex AI."
				},
				"opencode.kiloGatewayApiKey": {
					"type": "string",
					"default": "",
					"description": "Kilo Gateway API key."
				},
				"opencode.huggingfaceApiKey": {
					"type": "string",
					"default": "",
					"description": "Hugging Face API key."
				},
				"opencode.ezifApiKey": {
					"type": "string",
					"default": "",
					"description": "ezif API key."
				},
				"opencode.opencodeGoApiKey": {
					"type": "string",
					"default": "",
					"description": "OpenCode Go API key."
				},
				"opencode.opencodeZenApiKey": {
					"type": "string",
					"default": "",
					"description": "OpenCode Zen API key."
				},
				"opencode.modelConfig.provider": {
					"type": "string",
					"default": "openai",
					"description": "Selected AI provider for OpenCode."
				},
				"opencode.modelConfig.model": {
					"type": "string",
					"default": "",
					"description": "Selected AI model for OpenCode."
				},
				"opencode.modelConfig.apiEndpoint": {
					"type": "string",
					"default": "",
					"description": "Custom API endpoint URL."
				},
				"opencode.modelConfig.temperature": {
					"type": "number",
					"default": 0.7,
					"description": "Temperature parameter for model responses (0.0-2.0)."
				},
				"opencode.modelConfig.maxTokens": {
					"type": "number",
					"default": 8192,
					"description": "Maximum tokens for model responses."
				}
			}
		},
		"menus": {
			"editor/context": [
				{
					"command": "opencode.addSelectionToPrompt",
					"when": "editorTextFocus",
					"group": "navigation@9"
				}
			],
			"commandPalette": [
				{
					"command": "opencode.modelConfig",
					"when": "false"
				}
			],
			"opencode/modelConfig": [
				{
					"command": "opencode.config.setModel",
					"label": "Model Selection"
				},
				{
					"command": "opencode.config.setApiEndpoint",
					"label": "API Endpoint"
				},
				{
					"command": "opencode.config.setTemperature",
					"label": "Temperature"
				},
				{
					"command": "opencode.config.setMaxTokens",
					"label": "Max Tokens"
				}
			]
		},
		"submenus": [
			{
				"id": "opencode.modelConfig",
				"label": "Model Configuration"
			}
		],
		"views": {
			"opencode": [
				{
					"type": "webview",
					"id": "opencode.chatView",
					"name": "",
					"icon": "media/icon.svg"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "opencode",
					"title": "OpenCode",
					"icon": "media/icon.svg"
				}
			]
		}
	},
	"activationEvents": [],
	"prettier": "@involvex/prettier-config",
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@opencode-ai/sdk": "^1.18.35",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-document": "^3.31.4",
		"@tiptap/extension-mention": "^3.31.4",
		"@tiptap/extension-paragraph": "^3.31.4",
		"@tiptap/extension-text": "^3.31.4",
		"@tiptap/suggestion": "^3.31.4",
		"marked": "^18.1.0",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.5.0",
		"solid-js": "^1.9.17",
		"tiptap-solid": "^1.2.1",
		"unified": "^11.0.5",
		"vite-plugin-solid": "^2.11.14",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@involvex/prettier-config": "^0.0.6",
		"@playwright/test": "^1.64.0",
		"@types/mocha": "^10.x",
		"@types/node": "^26.6.4",
		"@types/vscode": "^1.140.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.0.0",
		"commander": "^15.0.0",
		"concurrently": "^10.0.6",
		"eslint": "^10.12.0",
		"glob": "^13.0.6",
		"mocha": "^12.0.3",
		"prettier": "^3.9.9",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"engines": {
		"vscode": "^1.140.0"
	},
	"icon": "media/logo.png",
	"displayname": "Involvexs Awesome Opencode-Cli Gui",
	"packagemanager": "bun@1.3.14"
}
